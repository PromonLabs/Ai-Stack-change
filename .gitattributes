# Normalize line endings so a mixed Windows/Linux/CI team produces clean diffs.
* text=auto eol=lf

# Shell scripts must stay LF or they break in containers.
*.sh text eol=lf

# Windows-only scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary — never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.wasm binary

# Lockfiles: generated, keep them out of diff review.
package-lock.json -diff linguist-generated
pnpm-lock.yaml -diff linguist-generated
